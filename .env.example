# ── Base de datos ─────────────────────────────────────
POSTGRES_USER=resolvia
POSTGRES_PASSWORD=resolvia_dev
POSTGRES_DB=resolvia
# Puerto del host para PostgreSQL. Cámbialo (por ejemplo a 5433) si ya tienes otro PostgreSQL en el 5432
POSTGRES_PORT=5432
DATABASE_URL=postgresql://resolvia:resolvia_dev@localhost:5432/resolvia?schema=public

# ── API ───────────────────────────────────────────────
PORT=3000
# Orígenes permitidos por CORS, separados por comas (la web de Vite corre en el 5173)
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=1d

# ── Inteligencia artificial (ver docs/decisiones/0004) ─
# Modelo de chat. "openai-compatible" sirve para OpenAI, Azure OpenAI, Gemini,
# Mistral, vLLM, LM Studio y Ollama; "anthropic" usa la API de Claude.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://localhost:11434/v1
# Obligatoria con anthropic; Ollama local no la necesita
LLM_API_KEY=
LLM_CHAT_MODEL=llama3.2:3b
# Ejemplo con Claude: LLM_PROVIDER=anthropic, LLM_CHAT_MODEL=claude-haiku-4-5-20251001

# Modelo de embeddings (independiente del de chat)
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=nomic-embed-text
# Debe coincidir con la columna vector(768) del schema; cambiarla exige migración y reindexación
EMBEDDING_DIMENSIONS=768
