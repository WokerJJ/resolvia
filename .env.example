# ── Base de datos ─────────────────────────────────────
POSTGRES_USER=resolvia
POSTGRES_PASSWORD=resolvia_dev
POSTGRES_DB=resolvia
DATABASE_URL=postgresql://resolvia:resolvia_dev@localhost:5432/resolvia?schema=public

# ── API ───────────────────────────────────────────────
PORT=3000
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=1d

# ── Inteligencia artificial ───────────────────────────
# Proveedor del modelo de chat: "ollama" (local, gratis) o "anthropic" (API externa)
LLM_PROVIDER=ollama

# Ollama (modelo local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
# Los embeddings siempre se generan con Ollama (modelo liviano, 768 dimensiones)
OLLAMA_EMBED_MODEL=nomic-embed-text

# API externa (solo si LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
